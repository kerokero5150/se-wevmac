+#if IncludeSonyNew
+/*
+	SE WevMac: the Mac asked for a new host file (ExportFl). Make it in
+	/out of the virtual file system, zero filled, and insert it. The
+	page saves it for the user when the Mac ejects it.
+*/
+LOCALPROC MakeNewDisk(ui5b L, ui3p macname, ui5b macnamelen)
+{
+#define ZeroBufferSize 2048
+	char drivepath[64];
+	ui3b buffer[ZeroBufferSize];
+	blnr IsOk = falseblnr;
+	MyFilePtr refnum;
+
+	(void) mkdir("/out", 0777);
+	sprintf(drivepath, "/out/export%u", (unsigned)(++NewDiskCounter));
+	refnum = MyFileOpen(drivepath, "wb+");
+	if (NULL == refnum) {
+		MacMsg(kStrOpenFailTitle, kStrOpenFailMessage, falseblnr);
+	} else {
+		ui5b n = L;
+		blnr wrote = trueblnr;
+
+		memset(buffer, 0, ZeroBufferSize);
+		while (wrote && (n > 0)) {
+			ui5b i = (n > ZeroBufferSize) ? ZeroBufferSize : n;
+			if (MyFileWrite(buffer, 1, i, refnum) != i) {
+				wrote = falseblnr;
+			}
+			n -= i;
+		}
+		if (wrote) {
+			NextInsertIsNew = trueblnr;
+			NextInsertMacName = macname;
+			NextInsertMacNameLen = macnamelen;
+			macname = NULL; /* Sony_Insert0 owns it now */
+			IsOk = Sony_Insert0(refnum, falseblnr, drivepath);
+		} else {
+			MyFileClose(refnum);
+		}
+		if (! IsOk) {
+			(void) remove(drivepath);
+		}
+	}
+	if (NULL != macname) {
+		free(macname);
+	}
+}
+#endif
