+#if IncludeSonyGetName
+GLOBALOSGLUFUNC tMacErr vSonyGetName(tDrive Drive_No, tPbuf *r)
+{
+	/*
+		The name is the last part of the path. The page only uses
+		plain ASCII there, which is the same in MacRoman.
+	*/
+	char *drivepath = DriveNames[Drive_No];
+	if (NULL == drivepath) {
+		return mnvm_miscErr;
+	} else {
+		ui5b L;
+		ui3p p;
+		char *s = strrchr(drivepath, '/');
+		if (NULL == s) {
+			s = drivepath;
+		} else {
+			++s;
+		}
+		L = strlen(s);
+		p = (ui3p)malloc((0 == L) ? 1 : L);
+		if (NULL == p) {
+			return mnvm_miscErr;
+		}
+		(void) memcpy(p, s, L);
+		return PbufNewFromPtr(p, L, r);
+	}
+}
+#endif
